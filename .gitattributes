* text=auto

# Stable formatting / CI across Windows runners
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.pdf binary
.gitattributes text eol=lf
.github/**/*.yml text eol=lf

# The composite action ships these to Windows runners, where a CRLF checkout
# would make bash and awk read `\r` as part of every command.
action.yml text eol=lf
*.sh text eol=lf
*.awk text eol=lf

# Generated by tree-sitter CLI 0.25.8 from vendor/tree-sitter-go/grammar.js
crates/polint/vendor/tree-sitter-go/src/parser.c linguist-generated=true
crates/polint/vendor/tree-sitter-go/src/grammar.json linguist-generated=true
