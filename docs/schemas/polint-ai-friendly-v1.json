{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/oaiz-io/polint/main/docs/schemas/polint-ai-friendly-v1.json",
  "title": "PolintAiFriendlyReport",
  "description": "Machine output saved by `polint check --format ai-friendly`. Stdout stays compact; this file contains the queryable full diagnostic payload.",
  "type": "object",
  "required": [
    "version",
    "schema",
    "tool",
    "generated_at",
    "summary",
    "examples",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 2,
      "description": "Report format version; bumped to 2 when the run summary gained provider-outcome and budget rows. Every addition is optional, so a v1 consumer still reads a v2 report."
    },
    "schema": {
      "type": "string",
      "format": "uri"
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "generated_at": {
      "type": "string",
      "description": "Run timestamp label used for generated output file names."
    },
    "summary": {
      "type": "object",
      "required": [
        "total_diagnostics",
        "rules_triggered",
        "by_severity",
        "by_rule",
        "rules",
        "examples_limit"
      ],
      "additionalProperties": false,
      "properties": {
        "total_diagnostics": { "type": "integer", "minimum": 0 },
        "rules_triggered": { "type": "integer", "minimum": 0 },
        "by_severity": { "$ref": "#/$defs/severityCounts" },
        "by_rule": {
          "type": "array",
          "items": { "$ref": "#/$defs/ruleSummary" }
        },
        "rules": {
          "type": "array",
          "description": "Per registered rule, including zero-finding and capability-skipped rules.",
          "items": { "$ref": "#/$defs/ruleExecution" }
        },
        "providers": {
          "type": "array",
          "description": "Providers that failed or were blocked, plus providers that reported counters.",
          "items": { "$ref": "#/$defs/providerOutcome" }
        },
        "budgets": {
          "type": "array",
          "description": "Budgets this run exhausted.",
          "items": { "$ref": "#/$defs/budget" }
        },
        "examples_limit": { "type": "integer", "const": 10 }
      }
    },
    "examples": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/example" }
    },
    "truncation": {
      "type": "object",
      "required": ["total_diagnostics", "included_diagnostics", "reason"],
      "additionalProperties": false,
      "properties": {
        "total_diagnostics": { "type": "integer", "minimum": 0 },
        "included_diagnostics": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "polint-report-v1.json#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["info", "warn", "error"]
    },
    "severityCounts": {
      "type": "object",
      "required": ["error", "warn", "info"],
      "additionalProperties": false,
      "properties": {
        "error": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    },
    "textRange": {
      "type": "object",
      "required": ["start_line", "start_col", "end_line", "end_col"],
      "additionalProperties": false,
      "properties": {
        "start_line": { "type": "integer", "minimum": 0 },
        "start_col": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 0 },
        "end_col": { "type": "integer", "minimum": 0 }
      }
    },
    "ruleSummary": {
      "type": "object",
      "required": ["rule_id", "total", "by_severity"],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string" },
        "total": { "type": "integer", "minimum": 0 },
        "by_severity": { "$ref": "#/$defs/severityCounts" }
      }
    },
    "ruleExecution": {
      "type": "object",
      "required": [
        "rule_id",
        "planned",
        "capabilities_ok",
        "files_in_scope",
        "diagnostics_emitted"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string" },
        "planned": {
          "type": "boolean",
          "description": "True when the rule survived capability planning and will execute."
        },
        "capabilities_ok": {
          "type": "boolean",
          "description": "True when every requested capability is supported for this run."
        },
        "files_in_scope": {
          "type": "integer",
          "minimum": 0,
          "description": "Analyzed files matching this rule's files/allow_files filters."
        },
        "diagnostics_emitted": { "type": "integer", "minimum": 0 },
        "skipped_reason": {
          "type": "string",
          "description": "Present when planned or capabilities_ok is false; uses polint/capability wording."
        },
        "outcome": {
          "type": "string",
          "enum": ["analyzed", "capability_blocked", "not_planned"],
          "description": "What happened to this rule. Zero diagnostics mean different things in each."
        },
        "blocking_providers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Providers whose failure blocked this rule."
        },
        "observed_events": {
          "type": "integer",
          "minimum": 0,
          "description": "Operations this rule's policy queries examined. Zero with outcome=analyzed means the rule ran and matched nothing."
        }
      }
    },
    "providerCache": {
      "type": "object",
      "required": ["hits", "misses", "recomputes", "writes"],
      "additionalProperties": false,
      "properties": {
        "hits": { "type": "integer", "minimum": 0 },
        "misses": { "type": "integer", "minimum": 0 },
        "recomputes": { "type": "integer", "minimum": 0 },
        "writes": { "type": "integer", "minimum": 0 }
      }
    },
    "providerOutcome": {
      "type": "object",
      "required": ["provider_id", "status"],
      "additionalProperties": false,
      "properties": {
        "provider_id": { "type": "string" },
        "status": {
          "type": "string",
          "description": "Sealed provider outcome status."
        },
        "stage": {
          "type": "string",
          "description": "Failure stage, when the provider failed."
        },
        "reason": {
          "type": "string",
          "description": "Failure reason, when the provider failed."
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Wall time of the provider stage; absent when it did not run."
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Providers whose failure blocked this one."
        },
        "cache": {
          "$ref": "#/$defs/providerCache",
          "description": "Cache counters; absent from the byte-stable check report because they describe the machine's cache state, not the analysis."
        },
        "counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "Provider-specific counters, such as a sidecar's per-stage timings."
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["budget", "status", "reported_by", "detail"],
      "additionalProperties": false,
      "properties": {
        "budget": {
          "type": "string",
          "description": "Budget identifier, such as cfg_dominance_pairs or solver_steps."
        },
        "status": { "type": "string" },
        "reported_by": {
          "type": "string",
          "description": "Diagnostic rule id that reported the trip."
        },
        "detail": { "type": "string" }
      }
    },
    "example": {
      "type": "object",
      "required": [
        "rule_id",
        "severity",
        "file",
        "range",
        "message",
        "labels",
        "help",
        "evidence",
        "suggestions",
        "fix",
        "stable_fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string" },
        "severity": { "$ref": "#/$defs/severity" },
        "file": { "type": "string" },
        "range": { "$ref": "#/$defs/textRange" },
        "message": { "type": "string" },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["range", "message"],
            "additionalProperties": false,
            "properties": {
              "range": { "$ref": "#/$defs/textRange" },
              "message": { "type": "string" }
            }
          }
        },
        "help": { "type": ["string", "null"] },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["message"],
            "additionalProperties": false,
            "properties": {
              "message": { "type": "string" }
            }
          }
        },
        "fix": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["message", "replacement"],
          "properties": {
            "message": { "type": "string" },
            "replacement": { "type": ["string", "null"] }
          }
        },
        "stable_fingerprint": { "type": "string" }
      }
    }
  }
}
