# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# insta: pending snapshot review files (not source of truth)
**/*.pending-snap

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
**/.polint/cache/**
# `polint init` writes this into each example when the suite runs; generated, not source.
**/.polint/.gitignore

# Local polint scaffold smoke dirs (validation / manual testing)
_scaffold_smoke_*/

# Third-party research checkouts; keep source snapshots local, not vendored.
research/*/repos/

# TypeScript installed for the type sidecar's tests; a tool dependency, not source.
node_modules/

# Benchmark reports written by `make eval-gate`; generated artifacts, not source.
.context/

# Transient harness runtime state (scheduled-tasks lock), not source.
.claude/scheduled_tasks.lock

# GSD plugin auto-checkpoint handoff, regenerated on tool use; not source.
.planning/HANDOFF.json

# Swarm gate evidence: per-task summaries are tracked; raw full-suite dumps are
# not — one reached 61 MB. Results and hashes live in .swarm/*.md.
.swarm/gate-logs/*-tests.log
.swarm/gate-logs/T-VERIFY-*.log
